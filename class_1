int main(){
	int x,j;
	for (x=1; x<=5; x++){
		cout<<'\n';
		for(j=1;j<=x;j++){
			cout<<"*";
		}
	}
}


int main(){
	int x,j;
	for (x=1 ; x<=5; x++){
		for(j=1;j<=5-x;j++){
				cout<<" ";
		}
		for(j=1; j<=2*x-1; j++){
			cout<<"*";
		}
		cout<<"\n";
	}
	
}

